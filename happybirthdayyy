<script>

/* TRANSIÇÃO ENTRE OS VÍDEOS */

const video1 = document.getElementById("video1");
const video2 = document.getElementById("video2");
const painel = document.getElementById("painel");
const botaoPular = document.getElementById("botaoPular");

let transicaoIniciada = false;

function iniciarTransicao() {
  if (transicaoIniciada) return;

  transicaoIniciada = true;
  botaoPular.style.display = "none";

  video2.style.display = "block";
  video2.currentTime = 0;
  video2.style.opacity = "0";

  const promessa = video2.play();

  if (promessa && promessa.catch) {
    promessa.catch(() => {});
  }

  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      video2.style.opacity = "1";
    });
  });

  // O painel começa a aparecer durante a transição dos vídeos.
  setTimeout(() => {
    painel.classList.add("visivel");
  }, 700);

  // O primeiro vídeo desaparece ao final da transição.
  setTimeout(() => {
    video1.pause();
    video1.style.display = "none";
  }, 2000);
}

/* DETECTAR OS DOIS SEGUNDOS FINAIS */

video1.addEventListener("timeupdate", () => {
  if (
    !transicaoIniciada &&
    Number.isFinite(video1.duration) &&
    video1.duration > 0 &&
    video1.duration - video1.currentTime <= 2
  ) {
    iniciarTransicao();
  }
});

video1.addEventListener("ended", iniciarTransicao);


/* PAINEL */

function fecharPainel() {
  painel.classList.remove("visivel");

  setTimeout(() => {
    if (!painel.classList.contains("visivel")) {
      document.getElementById("reabrirPainel").style.display = "block";
    }
  }, 500);
}

function abrirPainel() {
  document.getElementById("reabrirPainel").style.display = "none";

  requestAnimationFrame(() => {
    painel.classList.add("visivel");
  });
}


/* MÚSICAS */

function alternarMusicas() {
  document.getElementById("listaMusicas").classList.toggle("aberta");
}


/* 17 COISAS QUE AMO EM VOCÊ */

function alternarListaAmor() {
  document.getElementById("listaAmor").classList.toggle("aberta");
}


/* 17 COISAS QUE ME LEMBRAM VOCÊ */

function alternarLembrancas() {
  document.getElementById("listaLembrancas").classList.toggle("aberta");
