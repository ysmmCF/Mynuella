<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Uma surpresa para você</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #17101f;
  font-family: Georgia, serif;
  overflow: hidden;
}

/* VÍDEOS */

.video {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

#video1 {
  z-index: 0;
}

#video2 {
  display: none;
  opacity: 0;
  z-index: 1;
  transition: opacity 2s ease;
}

/* BOTÃO PULAR */

.pular-video {
  position: fixed;
  z-index: 4;
  top: 20px;
  right: 20px;
  padding: 11px 20px;
  border: 1px solid rgba(255,255,255,.6);
  border-radius: 25px;
  background: rgba(35,20,45,.45);
  color: white;
  font-family: Georgia, serif;
  font-size: 14px;
  cursor: pointer;
  backdrop-filter: blur(5px);
  transition: background .2s, transform .2s;
}

.pular-video:hover {
  background: rgba(35,20,45,.7);
  transform: translateY(-2px);
}

/* PAINEL PRINCIPAL */

.painel {
  position: fixed;
  z-index: 5;
  top: 7vh;
  bottom: 7vh;
  left: 18px;
  width: 370px;
  max-width: 85vw;
  padding: 27px 23px;
  overflow-y: auto;

  background:
    radial-gradient(ellipse at top, rgba(255,255,255,.55), transparent 55%),
    linear-gradient(155deg, #eadcf3 0%, #d9c2e9 55%, #c9addf 100%);

  border: 1px solid rgba(255,255,255,.7);
  border-radius: 23px;
  box-shadow:
    0 15px 45px rgba(0,0,0,.28),
    inset 0 0 25px rgba(255,255,255,.25);

  opacity: 0;
  visibility: hidden;
  transform: translateX(-35px);

  transition:
    opacity .7s ease,
    transform .7s cubic-bezier(.22,1,.36,1),
    visibility .7s;
}

.painel.visivel {
  opacity: 1;
  visibility: visible;
  transform: translateX(0);
}

.painel::-webkit-scrollbar {
  width: 5px;
}

.painel::-webkit-scrollbar-thumb {
  background: rgba(86,52,119,.35);
  border-radius: 10px;
}

.painel::-webkit-scrollbar-track {
  background: transparent;
}

/* CABEÇALHO */

.cabecalho-painel {
  text-align: center;
  padding: 7px 0 20px;
  border-bottom: 1px solid rgba(86,52,119,.2);
}

.detalhe-cabecalho {
  display: block;
  color: #8662a4;
  font-size: 15px;
  letter-spacing: 7px;
  margin-bottom: 9px;
}

.painel h2 {
  color: #563477;
  font-size: 25px;
  font-weight: normal;
  letter-spacing: .5px;
  margin: 0;
}

.subtitulo-painel {
  color: #795d91;
  font-size: 12px;
  margin-top: 9px;
  letter-spacing: .4px;
}

.fechar-painel {
  position: absolute;
  top: 12px;
  right: 15px;
  border: none;
  background: transparent;
  color: #694582;
  font-size: 25px;
  cursor: pointer;
  transition: transform .2s;
}

.fechar-painel:hover {
  transform: rotate(90deg);
}

/* ATALHOS */

.atalhos {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 13px;
  margin: 22px 0 0;
}

.atalho {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9px;
  width: 100%;
  min-height: 125px;
  padding: 16px 12px;

  border: 1px solid rgba(255,255,255,.65);
  border-radius: 17px;

  background: rgba(255,255,255,.32);
  box-shadow: 0 4px 13px rgba(86,52,119,.07);

  color: #563477;
  font-family: inherit;
  text-align: center;
  cursor: pointer;

  transition:
    background .25s ease,
    transform .25s ease,
    box-shadow .25s ease;
}

.atalho:hover {
  background: rgba(255,255,255,.55);
  transform: translateY(-2px);
  box-shadow: 0 7px 17px rgba(86,52,119,.12);
}

.icone {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 53px;
  height: 53px;

  border-radius: 50%;
  background: rgba(255,255,255,.5);
  border: 1px solid rgba(86,52,119,.17);

  color: #684486;
  font-size: 29px;
  line-height: 1;

  transition: transform .25s ease;
}

.atalho:hover .icone {
  transform: scale(1.08);
}

.titulo-atalho {
  color: #563477;
  font-size: 16px;
  letter-spacing: .2px;
}

.descricao-atalho {
  color: #806797;
  font-size: 12px;
  line-height: 1.4;
}

/* LISTA DE MÚSICAS */

.lista-musicas {
  display: none;
  flex-direction: column;
  gap: 8px;
  padding: 12px 14px 5px;
  animation: aparecerLista .35s ease;
}

.lista-musicas.aberta {
  display: flex;
}

.lista-musicas a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 13px;

  color: #563477;
  font-size: 14px;
  text-decoration: none;

  background: rgba(255,255,255,.32);
  border: 1px solid rgba(255,255,255,.45);
  border-radius: 10px;

  transition: background .2s, transform .2s;
}

.lista-musicas a::before {
  content: "♫";
  color: #8662a4;
  font-size: 17px;
}

.lista-musicas a:hover {
  background: rgba(255,255,255,.65);
  transform: translateX(3px);
}

/* LISTAS DE 17 ITENS */

.lista-amor {
  display: none;
  flex-direction: column;
  gap: 8px;
  padding: 12px 14px 5px;
  animation: aparecerLista .35s ease;
}

.lista-amor.aberta {
  display: flex;
}

.lista-amor div {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 11px 13px;

  color: #563477;
  font-size: 14px;
  line-height: 1.5;

  background: rgba(255,255,255,.32);
  border: 1px solid rgba(255,255,255,.45);
  border-radius: 10px;

  transition: background .2s, transform .2s;
}

.lista-amor div:hover {
  background: rgba(255,255,255,.6);
  transform: translateX(3px);
}

.lista-amor span {
  color: #8662a4;
  font-size: 12px;
  flex-shrink: 0;
  padding-top: 2px;
}

@keyframes aparecerLista {
  from {
    opacity: 0;
    transform: translateY(-7px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* DIVISÓRIA */

.divisoria {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 23px 0 20px;
  color: #8968a2;
  font-size: 13px;
}

.divisoria::before,
.divisoria::after {
  content: "";
  flex: 1;
  height: 1px;
  background: rgba(86,52,119,.2);
}

/* PERSONAGENS */

.secao-personagens {
  margin-top: 0;
}

.secao-personagens h3 {
  color: #563477;
  font-size: 17px;
  font-weight: normal;
  margin: 0 0 7px;
  text-align: center;
}

.subtitulo-personagens {
  color: #806797;
  font-size: 12px;
  text-align: center;
  margin: 0 0 17px;
}

.personagens {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.personagem {
  display: flex;
  align-items: center;
  gap: 13px;
  width: 100%;
  padding: 10px 12px;

  border: 1px solid rgba(255,255,255,.5);
  border-radius: 14px;
  background: rgba(255,255,255,.27);

  cursor: pointer;
  color: #563477;
  font-family: inherit;
  font-size: 14px;
  text-align: left;

  transition: background .2s, transform .2s;
}

.personagem:hover {
  background: rgba(255,255,255,.55);
  transform: translateX(3px);
}

.personagem img,
.personagem .simbolo {
  flex-shrink: 0;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  object-fit: cover;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,.55);
  border: 2px solid rgba(86,52,119,.5);
  transition: transform .2s;
}

/* ENQUADRAMENTO DA GANJI E DA MAVIS */

.personagem img.imagem-enquadrada-topo {
  object-position: center top;
}

.personagem .simbolo {
  font-size: 25px;
  color: #79549a;
}

.personagem:hover img,
.personagem:hover .simbolo {
  transform: scale(1.06);
}

.nome-personagem {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.nome-personagem strong {
  font-size: 14px;
  font-weight: normal;
  color: #563477;
}

.nome-personagem small {
  font-size: 11px;
  color: #806797;
}

/* BOTÃO REABRIR PAINEL */

.reabrir-painel {
  display: none;
  position: fixed;
  z-index: 6;
  left: 0;
  top: 45%;
  padding: 13px 12px;
  border: none;
  border-radius: 0 12px 12px 0;
  background: #563477;
  color: white;
  font-size: 24px;
  cursor: pointer;
}

/* MODAIS */

.modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 10;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(15,8,22,.72);
  backdrop-filter: blur(4px);
}

.modal.aberto {
  display: flex;
  animation: surgirModal .3s ease;
}

@keyframes surgirModal {
  from { opacity: 0; }
  to { opacity: 1; }
}

.conteudo-modal {
  position: relative;
  width: 550px;
  max-width: 95vw;
  max-height: 85vh;
  overflow-y: auto;
  padding: 35px;
  border: 1px solid rgba(255,255,255,.7);
  border-radius: 20px;
  background: linear-gradient(145deg, #f2e8f8, #e5d3f0);
  color: #49305e;
  box-shadow: 0 15px 45px rgba(0,0,0,.3);
}

.conteudo-modal h2 {
  text-align: center;
  margin-top: 5px;
  color: #563477;
  font-weight: normal;
}

.fechar-modal {
  position: absolute;
  top: 10px;
  right: 15px;
  border: none;
  background: transparent;
  color: #563477;
  font-size: 27px;
  cursor: pointer;
}

/* ANIMAÇÃO DO ENVELOPE */

.animacao-envelope {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 15px auto 25px;
  height: 100px;
}

.envelope {
  position: relative;
  width: 110px;
  height: 75px;
  background: #b995d1;
  border-radius: 5px;
  animation: surgirEnvelope .6s ease both;
}

.envelope-corpo {
  position: absolute;
  inset: 0;
  background: #c9a9df;
  border-radius: 5px;
  clip-path: polygon(0 0,100% 0,100% 100%,0 100%);
}

.envelope-aba {
  position: absolute;
  inset: 0;
  background: #a77bc4;
  clip-path: polygon(0 0,100% 0,50% 65%);
  transform-origin: top;
  animation: abrirEnvelope .8s ease forwards;
  animation-delay: .5s;
  z-index: 2;
}

.envelope-coracao {
  position: absolute;
  z-index: 3;
  top: 28px;
  left: 42px;
  color: #753d83;
  font-size: 25px;
  animation: subirCoracao .8s ease forwards;
  animation-delay: 1s;
}

@keyframes abrirEnvelope {
  to { transform: rotateX(180deg); }
}

@keyframes subirCoracao {
  to {
    transform: translateY(-25px);
    opacity: 0;
  }
}

@keyframes surgirEnvelope {
  from {
    opacity: 0;
    transform: translateY(15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* TEXTO DA CARTA */

#conteudoCarta {
  opacity: 0;
  transition: opacity .8s ease;
}

#conteudoCarta.revelado {
  opacity: 1;
}

.texto-carta {
  white-space: pre-line;
  line-height: 1.8;
  font-size: 15px;
}

/* PERSONAGEM NO MODAL */

.foto-personagem-modal {
  display: block;
  width: 180px;
  height: 180px;
  margin: 15px auto;
  object-fit: cover;
  border-radius: 50%;
  border: 3px solid #563477;
}

/* ENQUADRAMENTO NO MODAL DA GANJI E DA MAVIS */

.foto-personagem-modal.imagem-enquadrada-topo {
  object-position: center top;
}

.descricao-personagem {
  text-align: center;
  line-height: 1.7;
  font-size: 15px;
}

@media (max-width: 500px) {
  .painel {
    left: 10px;
    width: 88vw;
    top: 5vh;
    bottom: 5vh;
    padding: 20px;
  }

  .conteudo-modal {
    padding: 28px 22px;
  }

  .atalho {
    min-height: 115px;
  }
}
</style>
</head>

